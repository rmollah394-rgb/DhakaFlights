{
  "name": "dhakaflights",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/dhaka-flights-today", "/schedule", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SCHEDULE_KV",
      "id": "c721413f2b6e48ec86ff9cc788acc9a5"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    }
  ]
}
